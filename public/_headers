# Netlify headers for better mobile compatibility

# Force CSS reload on mobile devices (fix iOS cache issue)
/static/css/*
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# Force JS reload on mobile devices  
/static/js/*
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# Cache images for better performance
/static/media/*
  Cache-Control: public, max-age=31536000, immutable

# Ensure proper MIME types for images
*.png
  Content-Type: image/png
  Cache-Control: public, max-age=31536000

*.jpg
  Content-Type: image/jpeg
  Cache-Control: public, max-age=31536000

# Enable compression and security
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block